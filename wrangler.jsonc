{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questlog",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  // ONLY public/ ships. Never point this at "./" -- that would publish .git,
  // node_modules and the Worker source along with the app.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/events"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "questlog",
      "database_id": "36dc1d23-04cd-49cb-8f77-b35702739525"
    }
  ]

  // Secret (not stored here):  wrangler secret put QUESTLOG_TOKEN
}
