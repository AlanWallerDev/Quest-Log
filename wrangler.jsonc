{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questlog",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  // Static PWA served from the repo root; the Worker handles /events.
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/events"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "questlog",
      "database_id": "PASTE_AFTER_CREATE"
    }
  ]

  // Secret (not stored here):  wrangler secret put QUESTLOG_TOKEN
}
